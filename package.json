{
  "name": "x100vi-tracker",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n web,worker \"pnpm dev:web\" \"pnpm dev:worker\"",
    "dev:web": "next dev apps/web --hostname 0.0.0.0",
    "dev:worker": "tsx watch apps/worker/src/index.ts",
    "build": "next build apps/web",
    "start": "next start apps/web --hostname 0.0.0.0",
    "worker": "tsx apps/worker/src/index.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:setup": "tsx scripts/setup-test.ts",
    "db:migrate:test": "tsx --env-file=.env.test scripts/migrate.ts",
    "owner:setup": "tsx scripts/setup.ts"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "next": "16.4.5",
    "next-auth": "4.24.15",
    "pg": "^8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "concurrently": "^9.2.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "prettier": "3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  },
  "type": "module"
}
